# ── Backend (Express + MongoDB) ────────────────────────────────────────────
# Render will inject PORT automatically. Locally, default is 5000.
PORT=5000
NODE_ENV=development

# MongoDB connection string (required)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/meeting_room?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace-with-strong-secret
JWT_EXPIRES_IN=8h
MEETING_LINK_SECRET=replace-with-strong-secret
MEETING_LINK_EXPIRES_IN=7d

# CORS — set CLIENT_URL to the main frontend origin and use CLIENT_URLS
# (comma-separated) to whitelist the rooms display app and any extras.
CLIENT_URL=https://your-frontend.vercel.app
CLIENT_URLS=https://your-frontend.vercel.app,https://your-rooms.vercel.app

# Used to build links inside outgoing emails
FRONTEND_URL=https://your-frontend.vercel.app
BACKEND_URL=https://your-render-backend.onrender.com

# SMTP for outbound mail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=app-specific-password
SMTP_FROM="Meeting Room <you@example.com>"
